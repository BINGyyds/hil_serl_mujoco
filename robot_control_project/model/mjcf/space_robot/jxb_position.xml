<mujoco model="jxb_position">

  <default>
    <default class="robot">
      <joint stiffness="0" damping="0" armature="1.0"/>
      <default class="motor">
        <joint />
        <motor />
      </default>
      <default class="visual">
        <geom material="visualgeom" contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom material="collision_material" condim="3" contype="0" conaffinity="1" priority="1" group="1" solref="0.005 1" friction="1 0.01 0.01" />
        <equality solimp="0.99 0.999 1e-05" solref="0.005 1" />
      </default>
    </default>
    <default class="robot_position">
      <position gear="1" ctrllimited="true" forcelimited="false" inheritrange="1"/>
    </default>
  </default>

  <compiler angle="radian" />
  <option gravity="0 0 0" integrator="implicitfast" />

  <!-- statistic 调整默认相机初始位置
    - center="x y z": 设置场景的中心点，相机会对准这里。 
    - extent="radius": 设置场景的范围（包围球半径）。
  -->
  <statistic center="0 0 0" extent="20.0" />

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>
  
  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    <material name="default_material" rgba="0.7 0.7 0.7 1" />
    <material name="collision_material" rgba="1.0 0.28 0.1 0.9" />
    <mesh name="base_link.STL" file="jxb_meshes/base_link.STL" />
    <mesh name="link1.STL" file="jxb_meshes/link1.STL" />
    <mesh name="link2.STL" file="jxb_meshes/link2.STL" />
    <mesh name="link3.STL" file="jxb_meshes/link3.STL" />
    <mesh name="link4.STL" file="jxb_meshes/link4.STL" />
    <mesh name="link5.STL" file="jxb_meshes/link5.STL" />
    <mesh name="link6.STL" file="jxb_meshes/link6.STL" />
    <mesh name="link7.STL" file="jxb_meshes/link7.STL" />
  </asset>

  <worldbody>
    <!-- <geom name="floor" type="plane" size="0 0 .05" material="grid" condim="3"/> -->
    <light name="spotlight" mode="targetbody" target="base_link" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="0 -6 4" cutoff="30"/>
    <light name="top" pos="0 0 5" mode="targetbody" target="base_link"/>
    <site name="origin" pos="0 0 0" size="0.01" type="sphere" rgba="1 0 0 1"/>
    <site name="climb_site" pos="0 5 3" quat="1 0 0 0" />

    <body name="load_A_body" pos="0. -5.0 5.0">
      <freejoint name="load_A_freejoint"/>
      <geom name="load_A_geom" type="box" size="0.5 0.5 0.5" />
      <inertial pos="0. 0. 0." quat="1.0 0.0 0.0 0.0" mass="2.7" diaginertia="0.0045 0.0045 0.0045" />
      <site name="load_A_site" pos="0 0 0" quat="1 0 0 0" size="0.001"/>
    </body>

    <body name="base_link" pos="0.00000000 0.00000000 0.00000000" quat="1 0 0 0" childclass="robot">
      <inertial pos="0 0 -0.5" quat="1.0 0.0 0.0 0.0" mass="28.274" diaginertia="2.9924 2.9924 1.2723" />
      <freejoint name="floating_base" />
      <geom name="base_link_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="base_link.STL" class="collision" />
      <geom name="base_link_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="" type="mesh" mesh="base_link.STL" class="visual" />
      <body name="link1" pos="0 0 1.3946" quat="1.0 0.0 0.0 0.0">
        <joint name="joint1" type="hinge" ref="0.0" class="motor" range="-4.2 4.2" axis="0 0 1" />
        <inertial pos="-2.4147E-08 -0.12374 -0.033299" quat="1.0 0.0 0.0 0.0" mass="26.519" diaginertia="2.6441 1.437 2.2777" />
        <geom name="link1_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="link1.STL" class="collision" />
        <geom name="link1_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="" type="mesh" mesh="link1.STL" class="visual" />
        <body name="link2" pos="0 -1.4 0" quat="0.4999981633974483 0.49999999999662686 0.49999999999662686 -0.5000018366025516">
          <joint name="joint2" type="hinge" ref="0.0" class="motor" range="-4.2 4.2" axis="0 0 1" />
          <inertial pos="2.4147E-08 -0.033299 -0.12374" quat="1.0 0.0 0.0 0.0" mass="26.519" diaginertia="2.6441 2.2777 1.437" />
          <geom name="link2_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="link2.STL" class="collision" />
          <geom name="link2_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="" type="mesh" mesh="link2.STL" class="visual" />
          <body name="link3" pos="0 -0.84462 0" quat="-2.5973434669646147e-06 2.597353007557415e-06 0.7071080798547033 -0.707105482506466">
            <joint name="joint3" type="hinge" ref="0.0" class="motor" range="-4.2 4.2" axis="0 0 1" />
            <inertial pos="3.24999928445104 -8.30825477304842E-08 9.30659118658639E-07" quat="1.0 0.0 0.0 0.0" mass="165.055598878672" diaginertia="7.67393622730273 859.721114184828 857.903591002343" />
            <geom name="link3_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="link3.STL" class="collision" />
            <geom name="link3_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="" type="mesh" mesh="link3.STL" class="visual" />
            <body name="link4" pos="6.5 0 0.9" quat="-3.673205103346574e-06 0.0 -0.0 -0.9999999999932537">
              <joint name="joint4" type="hinge" ref="0.0" class="motor" range="-4.2 4.2" axis="0 0 1" />
              <inertial pos="3.25000071554896 -8.30825486186626E-08 -9.3065911777046E-07" quat="1.0 0.0 0.0 0.0" mass="165.055598878671" diaginertia="7.67393622730272 859.721114184827 857.903591002342" />
              <geom name="link4_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="link4.STL" class="collision" />
              <geom name="link4_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="" type="mesh" mesh="link4.STL" class="visual" />
              <body name="link5" pos="6.5 0 0.84462" quat="1.0 0.0 0.0 0.0">
                <joint name="joint5" type="hinge" ref="0.0" class="motor" range="-4.2 4.2" axis="0 0 1" />
                <inertial pos="-2.4147E-08 -0.12374 -0.033299" quat="1.0 0.0 0.0 0.0" mass="26.519" diaginertia="2.6441 1.437 2.2777" />
                <geom name="link5_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="link5.STL" class="collision" />
                <geom name="link5_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="" type="mesh" mesh="link5.STL" class="visual" />
                <body name="link6" pos="0 -1.4 0" quat="0.4999981633974483 0.49999999999662686 -0.49999999999662686 0.5000018366025516">
                  <joint name="joint6" type="hinge" ref="0.0" class="motor" range="-4.2 4.2" axis="0 0 1" />
                  <inertial pos="2.41473299134043E-08 -0.0332987872996737 -0.123744412237511" quat="1.0 0.0 0.0 0.0" mass="26.5185252602342" diaginertia="2.64411663116475 2.27771417994653 1.43697100438134" />
                  <geom name="link6_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="link6.STL" class="collision" />
                  <geom name="link6_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="" type="mesh" mesh="link6.STL" class="visual" />
                  <body name="link7" pos="0 -1.3946 0" quat="0.7071054825112363 0.7071080798594735 0.0 0.0">
                    <site name="end_effector_site" pos="0 0 0" quat="1 0 0 0" />
                    <joint name="joint7" type="hinge" ref="0.0" class="motor" range="-4.2 4.2" axis="0 0 1" />
                    <inertial pos="0 0 -0.5" quat="1.0 0.0 0.0 0.0" mass="28.274" diaginertia="2.9924 2.9924 1.2723" />
                    <geom name="link7_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="link7.STL" class="collision" />
                    <geom name="link7_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="" type="mesh" mesh="link7.STL" class="visual" />
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
      <site name="base_link_site" pos="0 0 0" quat="1 0 0 0" />
      <camera name="front_camera" mode="track" fovy="90.0" quat="4.329780281177467e-17 4.329780281177467e-17 0.7071067811865476 0.7071067811865476" pos="0.0 2.0 0.5" />
      <camera name="side_camera" mode="track" fovy="90.0" quat="-0.5 -0.5 0.5000000000000001 0.5000000000000001" pos="-2.0 0.0 0.5" />
    </body>
  </worldbody>

  <equality>
    <weld name="weld_base_origin" site1="origin" site2="base_link_site" torquescale="100" active="true"/>
    <weld name="weld_ee_climbsite" site1="climb_site" site2="end_effector_site" torquescale="100" active="false"/>
    <weld name="weld_jxb_loadA" site1="end_effector_site" site2="load_A_site" torquescale="100" active="false"/>
  </equality>

  <!-- forcerange无效 -->
  <!-- <actuator>
    <position class="robot_position" name="joint1_ctrl" joint="joint1" kp="300" kv="3000"/>
    <position class="robot_position" name="joint2_ctrl" joint="joint2" kp="300" kv="3000"/>
    <position class="robot_position" name="joint3_ctrl" joint="joint3" kp="200" kv="2500"/>
    <position class="robot_position" name="joint4_ctrl" joint="joint4" kp="200" kv="2500"/>
    <position class="robot_position" name="joint5_ctrl" joint="joint5" kp="50" kv="150"/>
    <position class="robot_position" name="joint6_ctrl" joint="joint6" kp="50" kv="50"/>
    <position class="robot_position" name="joint7_ctrl" joint="joint7" kp="50" kv="50"/>
  </actuator> -->

  <actuator>
    <position class="robot_position" name="joint1_ctrl" joint="joint1" kp="3000" kv="800"/>
    <position class="robot_position" name="joint2_ctrl" joint="joint2" kp="3000" kv="800"/>
    <position class="robot_position" name="joint3_ctrl" joint="joint3" kp="2000" kv="4000"/>
    <position class="robot_position" name="joint4_ctrl" joint="joint4" kp="2000" kv="4000"/>
    <position class="robot_position" name="joint5_ctrl" joint="joint5" kp="500" kv="250"/>
    <position class="robot_position" name="joint6_ctrl" joint="joint6" kp="500" kv="100"/>
    <position class="robot_position" name="joint7_ctrl" joint="joint7" kp="500" kv="100"/>
  </actuator>

  <contact>
    <exclude body1="base_link" body2="link1" />
    <exclude body1="link1" body2="link2" />
    <exclude body1="link2" body2="link3" />
    <exclude body1="link3" body2="link4" />
    <exclude body1="link4" body2="link5" />
    <exclude body1="link5" body2="link6" />
    <exclude body1="link6" body2="link7" />
    <exclude body1="link7" body2="load_A_body" />
  </contact>

  <sensor>
    <framepos name="base_link_site_pos" objtype="site" objname="base_link_site" />
    <framequat name="base_link_site_quat" objtype="site" objname="base_link_site" />
    <framelinvel name="base_link_site_linvel" objtype="site" objname="base_link_site" />
    <frameangvel name="base_link_site_angvel" objtype="site" objname="base_link_site" />
    <velocimeter name="base_link_site_vel" site="base_link_site" />
  </sensor>
</mujoco>